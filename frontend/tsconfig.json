{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["vite/client", "vitest/globals"],
    "noUncheckedIndexedAccess": false,
    "paths": { "@/*": ["./src/*"] }
  }
}
